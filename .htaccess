# Apache settings for DreamHost hosting
ErrorDocument 404 /404.html

RewriteEngine On
# Send http:// and www. to https://seangarciafilm.com
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://seangarciafilm.com%{REQUEST_URI} [L,R=301]

# Cache fonts and images for a month
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

# Pages must always be re-checked so visitors get updates straight away.
# CSS and JS carry a ?v= version in their URL, so they can be cached for a long time.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Never serve the Gmail password file
<Files "gmail-password.php">
  Require all denied
</Files>
